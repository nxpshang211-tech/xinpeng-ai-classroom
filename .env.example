# 必填：Qwen ASR、课堂笔记、思维导图、出题和简答题评分共用
DASHSCOPE_API_KEY=

# 默认模型通常不需要修改
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_TEXT_MODEL=qwen-flash
DASHSCOPE_ASR_TRANSPORT=base64
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ASR_CHUNK_SECONDS=285
DASHSCOPE_ASR_MAX_MB=9
DASHSCOPE_ASR_RETRIES=5

# 可选：不填写时自动跳过扩展资料搜索，不影响其他处理步骤
ALIYUN_SEARCH_API_KEY=
ALIYUN_SEARCH_ENDPOINT=

# 本地 SQLite 与上传限制
DATABASE_URL=sqlite:///./data/course.db
MAX_UPLOAD_MB=500

# 本地演示可保留默认值；公开部署前请替换为同长度随机值
TOKEN_AES_KEY=chapter07-demo-k
TOKEN_AES_IV=chapter07-demo-i
